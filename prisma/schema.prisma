// Mirrors the JSON schemas in /Entities. Field names stay snake_case so the
// frontend can use records as-is. Enum-like fields are strings validated in
// lib/entities.ts against lib/constants.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection used by the app at runtime
  url       = env("DATABASE_URL")
  // Direct (non-pooled) connection used by migrations
  directUrl = env("DIRECT_URL")
}

model Flat {
  id           String                @id @default(cuid())
  flat_number  String
  floor        Int?
  block        String?
  status       String                @default("Not Started")
  owner_name   String?
  created_date DateTime              @default(now())
  updated_date DateTime              @updatedAt
  notes        WorkNote[]
  transactions MaterialTransaction[]
}

model Material {
  id              String                @id @default(cuid())
  name            String
  category        String                @default("Other")
  quantity        Float
  unit            String                @default("Pieces")
  min_stock_level Float?
  location        String?
  created_date    DateTime              @default(now())
  updated_date    DateTime              @updatedAt
  transactions    MaterialTransaction[]
}

model MaterialTransaction {
  id           String   @id @default(cuid())
  material_id  String
  material     Material @relation(fields: [material_id], references: [id], onDelete: Cascade)
  type         String   @default("Usage")
  quantity     Float
  flat_id      String?
  flat         Flat?    @relation(fields: [flat_id], references: [id], onDelete: SetNull)
  notes        String?
  date         String // YYYY-MM-DD, kept as text so it never shifts across time zones
  created_date DateTime @default(now())
  updated_date DateTime @updatedAt
}

model WorkNote {
  id           String   @id @default(cuid())
  flat_id      String
  flat         Flat     @relation(fields: [flat_id], references: [id], onDelete: Cascade)
  category     String   @default("Other")
  title        String
  description  String?
  status       String   @default("Pending")
  priority     String   @default("Medium")
  image_url    String?
  created_date DateTime @default(now())
  updated_date DateTime @updatedAt
}

// ---- Access control ----

// People allowed to sign in, managed from the Team page. Admins come from the
// ADMIN_EMAILS env var instead, so they can never be removed by accident.
model AllowedUser {
  email        String   @id
  added_by     String?
  created_date DateTime @default(now())
}

// ---- Auth.js tables (used by @auth/prisma-adapter) ----
// Sessions are JWT cookies, but magic links need VerificationToken and the
// adapter records which sign-in methods each person has used.

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}
