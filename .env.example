# Copy to .env and fill in. Never commit .env.
# On Vercel, set these in Project Settings -> Environment Variables.

# Random secret used to sign session cookies. Generate with: npx auth secret
AUTH_SECRET=

# Google OAuth client (optional; https://console.cloud.google.com/apis/credentials)
# Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://<your-app>.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Admins (comma-separated): always allowed, and can add/remove people on the
# Team page. Everyone else is managed in the app, no redeploy needed.
ADMIN_EMAILS=you@gmail.com

# Magic-link sign-in email (SMTP). Leave empty to offer Google sign-in only.
# Local dev: the Mailpit container in docker-compose.yml, inbox at http://localhost:8025
#   EMAIL_SERVER=smtp://localhost:1025
# Gmail: turn on 2-Step Verification, create an App Password
# (https://myaccount.google.com/apppasswords), then:
#   EMAIL_SERVER=smtps://you%40gmail.com:<app-password-without-spaces>@smtp.gmail.com:465
#   EMAIL_FROM="SiteManager <you@gmail.com>"
EMAIL_SERVER=smtp://localhost:1025
EMAIL_FROM="SiteManager <noreply@sitemanager.local>"

# Postgres. Local dev uses docker-compose.yml (both URLs the same).
# On Neon: DATABASE_URL = pooled connection string (host contains "-pooler"),
#          DIRECT_URL   = direct connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sitemanager"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/sitemanager"
