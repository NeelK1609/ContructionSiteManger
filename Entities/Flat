{
  "name": "Flat",
  "type": "object",
  "properties": {
    "flat_number": {
      "type": "string",
      "description": "Flat Number (e.g., A-101)"
    },
    "floor": {
      "type": "number"
    },
    "block": {
      "type": "string",
      "description": "Block or Wing name"
    },
    "status": {
      "type": "string",
      "enum": [
        "Not Started",
        "In Progress",
        "Near Completion",
        "Completed",
        "Handed Over"
      ],
      "default": "Not Started"
    },
    "owner_name": {
      "type": "string",
      "description": "Name of the flat owner (optional)"
    }
  },
  "required": [
    "flat_number"
  ]
}